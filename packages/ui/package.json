{
  "name": "@repo/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./counter": {
      "types": "./dist/components/counter.d.ts",
      "default": "./dist/components/counter.js"
    },
    "./header": {
      "types": "./dist/components/header.d.ts",
      "default": "./dist/components/header.js"
    },
    "./setup-counter": {
      "types": "./dist/utils/counter.d.ts",
      "default": "./dist/utils/counter.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "eslint": "^8.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "5.5.4",
    "vite": "^5.1.4",
    "vitest": "^3.1.1"
  }
}
